{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "template-frizeri",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "template-frizeri-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "demo-podfolder",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4175",
        "--strictPort",
        "--base",
        "/template/"
      ],
      "port": 4175
    }
  ]
}
